{
  "name": "ai-video-transcriber-desktop",
  "version": "1.1.0",
  "description": "AI Video Transcriber - application de bureau (Electron + FastAPI)",
  "main": "main.js",
  "author": "Gédéon Compaore",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:backend": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "ffmpeg": "powershell -ExecutionPolicy Bypass -File scripts/download-ffmpeg.ps1",
    "dist": "electron-builder --win",
    "dist:full": "npm run build:backend && npm run ffmpeg && electron-builder --win",
    "build:backend:unix": "bash scripts/build-backend.sh",
    "ffmpeg:unix": "bash scripts/download-ffmpeg.sh",
    "dist:mac": "electron-builder --mac",
    "dist:full:mac": "npm run build:backend:unix && npm run ffmpeg:unix && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gedeon.aivideotranscriber",
    "productName": "AI Video Transcriber",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-splash.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "dist-backend/AVT-Backend",
        "to": "backend/AVT-Backend"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "AI Video Transcriber",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
